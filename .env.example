# Copy to .env and fill in. Never commit .env.

# Identify yourself to site owners. Required in practice: anonymous crawlers get blocked.
VATDISC_CONTACT=you@example.com

# Where the sqlite DB, downloads and reports live
VATDISC_DATA_DIR=data

# Sampling seed (record it in your write-up)
VATDISC_SEED=42

# HMRC "Check a UK VAT number" API v2 (needs a developer-hub application: https://developer.service.hmrc.gov.uk)
# Start with the sandbox, which only knows the published mock VAT numbers:
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
# Production: https://api.service.hmrc.gov.uk
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Leave empty unless the token endpoint rejects the request without a scope
HMRC_SCOPE=
# Requests per second against HMRC. Be conservative; 429s are backed off automatically.
HMRC_RPS=2
# Hard stop on HMRC calls per process run: protects you from loops and from yourself.
HMRC_MAX_CALLS=2000

# Website crawling
VATDISC_HTTP_DELAY=1.0
VATDISC_HTTP_TIMEOUT=10
VATDISC_MAX_PAGES_PER_SITE=8
